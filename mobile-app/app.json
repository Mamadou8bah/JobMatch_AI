{
  "expo": {
    "name": "JobMatch AI",
    "slug": "jobmatch-ai",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/jobmatch_logo.png",
    "userInterfaceStyle": "light",
    "scheme": "jobmatch",
    "splash": {
      "image": "./assets/jobmatch_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jobmatch.ai"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/jobmatch_logo.png",
        "backgroundColor": "#111827"
      },
      "package": "com.jobmatch.ai"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow JobMatch AI to access your photos to set a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://jobmatchgambia.onrender.com/api",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8cad8e3b-40f5-437e-bd6f-77ee44890d0e"
      }
    }
  }
}
